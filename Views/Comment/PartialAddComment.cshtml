<div class="comment-top">
	<h4>Yorum Bırakın</h4>
	<div class="comment-bottom">
		<!-- Form'a 'commentForm' ID'sini ekledik -->
		<form id="commentForm" action="/Comment/PartialAddComment/" method="post">
			<input class="form-control" type="text" name="CommentUserName" placeholder="Adınız Soyadınız" required="">
			<!-- Boşluk bırakmak için alt marj (mb-3) ekleyebilirsiniz, ben orijinal halini bıraktım -->
			<input class="form-control" type="text" name="CommentTitle" placeholder="Konu" required="">

			@* <input class="form-control" type="text" name="CommnetContent" placeholder="Yorumunuz..." required=""> *@

			<textarea class="form-control" name="CommentContent" placeholder="Yorumunuz..." required=""></textarea>
			<button type="submit" class="btn btn-primary submit">Yorum Yap</button>
		</form>

		<!-- AJAX tamamlandıktan sonra mesajın çıkacağı alan -->
		<div id="commentResultMessage" class="alert mt-3" style="display: none; font-weight: bold;"></div>
	</div>
</div>
<script>
    document.getElementById('commentForm').addEventListener('submit', function(e) {
        
        // 1. Sayfanın yenilenmesini engelle
        e.preventDefault();

        const form = this;
        const formData = new FormData(form);
        const resultMessage = document.getElementById('commentResultMessage');

        // 2. Kullanıcıya işlem yapıldığını göster (Bootstrap alert sınıflarını kullanıyoruz)
        resultMessage.style.display = 'block';
        resultMessage.className = 'alert alert-secondary mt-3'; // Gri bekleme kutusu
        resultMessage.innerText = 'Yorumunuz gönderiliyor, lütfen bekleyin...';

        // Butonu geçici olarak devre dışı bırakıp çift tıklamayı (spam'i) engelle
        const submitBtn = form.querySelector('button[type="submit"]');
        submitBtn.disabled = true;

        // 3. Veriyi arka planda Controller'a gönder
        fetch(form.action, {
            method: form.method,
            body: formData
        })
        .then(response => {
            // Butonu tekrar aktif et
            submitBtn.disabled = false;

            if (response.ok) {
                // Başarılı (Bootstrap yeşil alert)
                resultMessage.className = 'alert alert-success mt-3';
                resultMessage.innerText = 'Yorumunuz başarıyla gönderildi! Onaylandıktan sonra yayınlanacaktır. 🎉';
                form.reset(); // Formun içindeki yazıları temizle
            } else {
                // Hata durumu (Bootstrap kırmızı alert)
                resultMessage.className = 'alert alert-danger mt-3';
                resultMessage.innerText = 'Yorumunuz gönderilirken bir hata oluştu. Lütfen tekrar deneyin.';
            }
        })
        .catch(error => {
            submitBtn.disabled = false;
            resultMessage.className = 'alert alert-danger mt-3';
            resultMessage.innerText = 'Bağlantı hatası! Lütfen internetinizi kontrol edin.';
            console.error('Yorum Gönderme Hatası:', error);
        });
    });
</script>
