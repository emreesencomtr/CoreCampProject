
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}


<html lang="zxx">

<head>
	<title>Weblog a Blogging Category Bootstrap responsive WebTemplate | Login :: w3layouts</title>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta charset="utf-8">
	<meta name="keywords" content="Weblog a Responsive web template, Bootstrap Web Templates, Flat Web Templates, Android Compatible web template,
	Smartphone Compatible web template, free webdesigns for Nokia, Samsung, LG, SonyEricsson, Motorola web design" />

	<script>
			addEventListener("load", function () {
				setTimeout(hideURLbar, 0);
			}, false);

			function hideURLbar() {
				window.scrollTo(0, 1);
			}
	</script>
	<link href="css/bootstrap.css" rel='stylesheet' type='text/css' />
	<link href="css/single.css" rel='stylesheet' type='text/css' />
	<link href="css/style.css" rel='stylesheet' type='text/css' />
	<link href="css/fontawesome-all.css" rel="stylesheet">
	<link href="//fonts.googleapis.com/css?family=Poppins:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800"
		  rel="stylesheet">

	<style>
			.modern-login-section {
				font-family: 'Poppins', sans-serif;
				background-color: #f8f9fa;
				padding: 60px 0;
			}

			.modern-card {
				background: #ffffff;
				border-radius: 16px;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
				padding: 50px 40px;
				border: none;
			}

			.modern-title {
				font-weight: 600;
				color: #2b3445;
				margin-bottom: 35px;
				text-align: center;
				font-size: 28px;
			}

			.modern-label {
				font-weight: 500;
				color: #4a5568;
				margin-bottom: 8px;
				font-size: 14px;
			}

			.modern-input {
				border-radius: 10px;
				border: 1px solid #e2e8f0;
				padding: 12px 16px;
				height: auto;
				font-size: 15px;
				color: #2d3748;
				transition: all 0.3s ease;
				background-color: #fcfcfc;
			}

				.modern-input:focus {
					border-color: #667eea;
					box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
					background-color: #ffffff;
					outline: none;
				}

			.modern-btn {
				background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
				border: none;
				border-radius: 10px;
				padding: 14px;
				font-weight: 600;
				font-size: 16px;
				letter-spacing: 0.5px;
				color: #ffffff;
				transition: all 0.3s ease;
				width: 100%;
				margin-top: 15px;
			}

				.modern-btn:hover {
					transform: translateY(-2px);
					box-shadow: 0 8px 20px rgba(118, 75, 162, 0.3);
					color: #ffffff;
				}

			.register-link-wrapper {
				text-align: center;
				margin-top: 25px;
			}

			.register-link {
				font-size: 14px;
				color: #718096;
				text-decoration: none;
				transition: color 0.3s ease;
			}

				.register-link strong {
					color: #764ba2;
				}

				.register-link:hover {
					color: #2d3748;
					text-decoration: none;
				}
		
			/* Checkbox özel ayarı */
			.modern-check-label {
				margin-top: 2px;
				cursor: pointer;
			}
	</style>
</head>

<body>
	


	<section class="main-content-w3layouts-agileits modern-login-section">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-5 col-md-8">
					<div class="modern-card">
						<h3 class="modern-title">Oturum Aç</h3>
						<form action="#" method="post">
							<div class="form-group mb-4">
								<label class="modern-label" for="exampleInputEmail1">E-mail Adresiniz</label>
								<input type="email" class="form-control modern-input" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Enter your email" required="">
								<small id="emailHelp" class="form-text text-muted mt-2">E-posta adresinizi asla başkalarıyla paylaşmayacağız.</small>
							</div>
							
							<div class="form-group mb-4">
								<label class="modern-label" for="exampleInputPassword1">Şifre</label>
								<input type="password" class="form-control modern-input" id="exampleInputPassword1" placeholder="Enter your password" required="">
							</div>
							
							<div class="form-check mb-4">
								<input type="checkbox" class="form-check-input" id="exampleCheck1">
								<label class="form-check-label modern-label modern-check-label" for="exampleCheck1">Beni hatırla</label>
							</div>
							
							<button type="submit" class="btn modern-btn">Giriş Yap</button>
							
							<div class="register-link-wrapper">
								<p><a href="/Register/Index" class="register-link">Hesabınız yok mu? <strong>Buradan Kayıt Olun</strong></a></p>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</section>
	
	<script src="js/jquery-2.2.3.min.js"></script>
	<script src="js/move-top.js"></script>
	<script src="js/easing.js"></script>
	<script>
		jQuery(document).ready(function ($) {
		$(".scroll").click(function (event) {
		event.preventDefault();
		$('html,body').animate({
		scrollTop: $(this.hash).offset().top
		}, 900);
		});
		});
	</script>
	<script>
		$(document).ready(function () {
		/*
		var defaults = {
		containerID: 'toTop', // fading element id
		containerHoverID: 'toTopHover', // fading element hover id
		scrollSpeed: 1200,
		easingType: 'linear'
		};
		*/

		$().UItoTop({
		easingType: 'easeOutQuart'
		});

		});
	</script>
	<a href="#home" class="scroll" id="toTop" style="display: block;">
		<span id="toTopHover" style="opacity: 1;"> </span>
	</a>

	<script src="js/bootstrap.js"></script>


</body>

</html>
