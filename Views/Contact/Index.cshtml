
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<!DOCTYPE html>
<html lang="zxx">
<link href="~/CoreBlogTema/web/css/contact.css" rel="stylesheet" type="text/css" />
<body>

	<section class="main-content-w3layouts-agileits">

		<h3 class="tittle">Bize Ulaşın</h3>
		<p class="sub text-center">Fikrinizi konuşmaktan memnuniyet duyarız.</p>
		<div class="contact-map inner-sec">

			<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6229.972072394802!2d39.19907214123775!3d38.67218897239463!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4076bf850ade32a7%3A0x560862df2125bc5f!2zS8O8bHTDvHIsIDIzMTAwIEVsYXrEscSfIE1lcmtlei9FbGF6xLHEnw!5e0!3m2!1str!2str!4v1777999962250!5m2!1str!2str" 
					class="map" style="border:0" allowfullscreen=""></iframe>
		</div>
		<div class="ad-inf-sec bg-light">
			<div class="container">
				<div class="address row">

					<div class="col-lg-4 address-grid">
						<div class="row address-info">
							<div class="col-md-4 address-left text-center">
								<i class="far fa-map"></i>
							</div>
							<div class="col-md-8 address-right text-left">
								<h6>Adres</h6>
								<p>
									İstanbul, TÜRKİYE

								</p>
							</div>
						</div>

					</div>
					<div class="col-lg-4 address-grid">
						<div class="row address-info">
							<div class="col-md-4 address-left text-center">
								<i class="far fa-envelope"></i>
							</div>
							<div class="col-md-8 address-right text-left">
								<h6>Email</h6>
								<p>
									
									<a href="mailto:example@email.com"> emre@emreesen.com.tr</a>

								</p>
							</div>

						</div>
					</div>
					<div class="col-lg-4 address-grid">
						<div class="row address-info">
							<div class="col-md-4 address-left text-center">
								<i class="fas fa-mobile-alt"></i>
							</div>
							<div class="col-md-8 address-right text-left">
								<h6>Telefon</h6>
								<p>+90 212 233 2323</p>

							</div>

						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="container">
			<div class="contact_grid_right">
				<form id="contactForm" method="post">
					<div class="row contact_left_grid">
						<div class="col-md-6 con-left">
							<div class="form-group">
								<label for="validationCustom01 my-2">Adınız Soyadınız</label>
								<input class="form-control" type="text" name="ContactUserName" placeholder="" required="">
							</div>
							<div class="form-group">
								<label for="exampleFormControlInput1">Email Adresiniz</label>
								<input class="form-control" type="email" name="ContactMail" placeholder="" required="">
							</div>
							<div class="form-group">
								<label for="validationCustom03 my-2">Konu</label>
								<input class="form-control" type="text" name="ContactSubject" placeholder="" required="">
							</div>
						</div>
						<div class="col-md-6 con-right">
							<div class="form-group">
								<label for="textarea">Mesajınız</label>
								<textarea id="textarea" name="ContactMessage" placeholder=""></textarea>
							</div>
							<input id="btnSubmit" class="form-control btn btn-primary" type="submit" value="Gönder">

						</div>
					</div>
				</form>
				<div id="contactResultMessage" class="alert mt-3" style="display: none; font-weight: bold;"></div>
			</div>
		</div>
	</section>
	
	<script>
			document.getElementById('contactForm').addEventListener('submit', function (e) {
				// Sayfanın yenilenmesini engelle
				e.preventDefault();

				const form = this;
				const formData = new FormData(form);
				const resultMessage = document.getElementById('contactResultMessage');
				const submitBtn = document.getElementById('btnSubmit');

				// Kullanıcıya bilgi ver
				resultMessage.style.display = 'block';
				resultMessage.className = 'alert alert-info mt-3';
				resultMessage.innerText = 'Mesajınız iletiliyor, lütfen bekleyin...';
        
				// Butonu geçici olarak kapat
				submitBtn.disabled = true;

				// Arka plana (Controller) gönder
				fetch(form.action, {
					method: 'POST',
					body: formData
				})
				.then(response => {
					submitBtn.disabled = false;
            
					if (response.ok) {
						// Başarılı durumu
						resultMessage.className = 'alert alert-success mt-3';
						resultMessage.innerText = 'Mesajınız başarıyla bize ulaştı. En kısa sürede döneceğiz! 😊';
						form.reset(); // Formu temizle
					} else {
						// Sunucu hatası
						resultMessage.className = 'alert alert-danger mt-3';
						resultMessage.innerText = 'Bir hata oluştu. Lütfen bilgilerinizi kontrol edip tekrar deneyin.';
					}
				})
				.catch(error => {
					submitBtn.disabled = false;
					resultMessage.className = 'alert alert-danger mt-3';
					resultMessage.innerText = 'Bağlantı hatası! Lütfen internetinizi kontrol edin.';
					console.error('Hata:', error);
				});
			});
	</script>

</body>


