@using EntityLayer.Concrete
@model List<Blog>

@{
    ViewData["Title"] = "BlogListByWriter";
    Layout = "~/Views/Shared/WriterLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h2 class="fw-bold text-dark mb-1">Bloglarım</h2>
            <p class="text-muted mb-0">Yazdığınız tüm blog içeriklerini buradan yönetebilirsiniz.</p>
        </div>

        <a href="/Blog/AddBlog/" class="btn btn-primary shadow-sm">
            <i class="mdi mdi-plus"></i> Yeni Blog
        </a>
    </div>

    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table align-middle table-hover">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Blog Başlığı</th>
                            <th>Oluşturma Tarihi</th>
                            <th>Kategori</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-bold text-secondary">
                                    @item.BlogId
                                </td>

                                <td>
                                    <div class="fw-semibold text-dark">
                                        @item.BlogTitle
                                    </div>
                                </td>

                                <td>
                                    @item.BlogCreateDate.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    <span class="badge bg-info text-dark px-3 py-2 rounded-pill">
                                        @item.CategoryId
                                    </span>
                                </td>

                                <td>
                                    @if (item.BlogStatus == true)
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-2 rounded-pill">
                                            Pasif
                                        </span>
                                    }
                                </td>

                                <td>

                                    <div class="d-flex gap-2 flex-wrap">

                                        <a href="/Blog/EditBlog/@item.BlogId"
                                               class="btn btn-sm btn-outline-warning rounded-pill">
                                            <i class="mdi mdi-pencil"></i> Düzenle
                                        </a>

                                        <a href="/Blog/DeleteBlog/@item.BlogId"
                                               class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class="mdi mdi-delete"></i> Sil
                                        </a>

                                        <a href="/Blog/BlogReadAll/@item.BlogId"
                                               class="btn btn-sm btn-outline-primary rounded-pill">
                                            <i class="mdi mdi-eye"></i> Görüntüle
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>